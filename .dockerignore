# Keep the Docker build context small and never ship secrets to the Space.
.git
.gitignore
.dockerignore
node_modules
build
.docusaurus
.cache
coverage

# Secrets - the service receives these as platform env vars instead.
.env
.env.*
!.env.example

# Local/agent tooling caches
.claude
.claude-code-router
.config
.qwen
.specify
.history
.kilo

# Local vector store leftovers (the real store is data/ or Supabase)
chroma_db
chroma_db_test

# Not needed by the API image.
# NOTE: keep docs/ and data/ - the API loads data/index.* at startup.
docs/.vitepress
templates
diagrams
code
src
static
specs
history
scripts/check-wordcount.py
scripts/link-check.sh
scripts/verify.sh

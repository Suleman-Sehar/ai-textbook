# AI Textbook RAG - configuration
#
# Copy to .env for local development, or paste the values into the Hugging Face
# Space under "Settings -> Variables and secrets".
# NEVER commit a filled-in .env.

# ---------------------------------------------------------------------------
# Required: LLM
# ---------------------------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Required: CORS
# ---------------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
# No trailing slash. localhost is always allowed automatically.
ALLOWED_ORIGINS=https://physical-ai-textbook.vercel.app

# ---------------------------------------------------------------------------
# Optional: persistent vector store (Supabase pgvector)
# ---------------------------------------------------------------------------
# LEAVE ALL OF THESE EMPTY to use the default in-process index. The Space then
# rebuilds the index from docs/ at every cold start (~30s), which is fine for a
# 361-chunk textbook and needs no external service.
#
# Set them only if you want the index to survive Space restarts and rebuilds.
#
# `vecs` connects with a Postgres DSN. Prefer SUPABASE_DB_URL - copy it from
# Supabase -> Project Settings -> Database -> Connection string (URI), using the
# session pooler (port 5432) or transaction pooler (port 6543).
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Alternatively, let the app assemble the DSN from these. Supabase -> Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# e.g. us-east-1, us-west-2, eu-central-1, ap-southeast-1
SUPABASE_REGION=

# If Supabase is set, also run this once per project:
#   create extension if not exists vector;

# ---------------------------------------------------------------------------
# Optional: tuning (defaults shown)
# ---------------------------------------------------------------------------
# Collection/table name in pgvector.
COLLECTION_NAME=ai_textbook

# Embedding model. Changing this REQUIRES a full re-ingest: vectors from two
# different models cannot coexist in one collection.
# Must stay 384-dimensional (all-MiniLM-L6-v2 family).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Gemini model id.
GEMINI_MODEL=gemini-3.6-flash

# Number of chunks retrieved per question.
TOP_K=5

# Character budget for the context handed to the LLM.
MAX_CONTEXT_CHARS=8000

# Listen port. Hugging Face Spaces require 7860.
PORT=7860

# Gemini request timeout, milliseconds.
LLM_TIMEOUT_MS=60000

# Retrieval budget for a single chat request, seconds.
RETRIEVE_TIMEOUT_S=30

# Load the embedding model in the background after boot so /health answers fast.
WARMUP_ON_START=true

# Markdown source directory.
DOCS_DIR=docs

# Log level.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Frontend only (build time - set in Vercel, or .env for local dev)
# ---------------------------------------------------------------------------
# Full URL of the chat endpoint on the Hugging Face Space.
# VITE_CHAT_API_URL=https://<hf-username>-<space-name>.hf.space/api/chat

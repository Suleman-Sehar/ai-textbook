# AI Textbook RAG - configuration
#
# Copy to .env for local development, or paste the values into the Hugging Face
# Space under "Settings -> Variables and secrets".
# NEVER commit a filled-in .env.

# ---------------------------------------------------------------------------
# Required: LLM
# ---------------------------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Required: CORS
# ---------------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
# No trailing slash. localhost is always allowed automatically.
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Vector store
# ---------------------------------------------------------------------------
# DEFAULT: the committed precomputed index (data/index.npy + data/index.json),
# built by `python scripts/build_index.py`. Loads in milliseconds, needs no
# database, and survives a rebuild. Do NOT set SUPABASE_* unless you
# deliberately want a persistent pgvector index instead.
#
# Set these only for the optional Supabase pgvector backend:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Alternatively, let the app assemble the DSN from these. Supabase -> Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# e.g. us-east-1, us-west-2, eu-central-1, ap-southeast-1
SUPABASE_REGION=

# If Supabase is set, also run this once per project:
#   create extension if not exists vector;

# Collection/table name in pgvector (Supabase backend only).
COLLECTION_NAME=ai_textbook

# Embedding model. Must match what is recorded in data/index.json.
# all-MiniLM-L6-v2 produces 384-dim vectors.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Embedding runtime: `fastembed` (ONNX Runtime) or `sentence-transformers`
# (torch). Keep fastembed on Render free - torch does not fit in 512 MB.
EMBED_BACKEND=fastembed

# Directory holding index.npy / index.json.
INDEX_DIR=./data

# Where the markdown source lives, for rebuilding the index.
DOCS_DIR=docs

# ---------------------------------------------------------------------------
# Optional: tuning (defaults shown)
# ---------------------------------------------------------------------------
# Gemini model id.
GEMINI_MODEL=gemini-3.6-flash

# Number of chunks retrieved per question.
TOP_K=5

# Character budget for the context handed to the LLM.
MAX_CONTEXT_CHARS=8000

# Listen port. Render injects PORT at runtime; leave unset locally unless needed.
# PORT=7860

# Gemini request timeout, milliseconds.
LLM_TIMEOUT_MS=60000

# Retrieval budget for a single chat request, seconds.
RETRIEVE_TIMEOUT_S=30

# Upper bound a chat request will wait for background startup before returning
# 503. Keeps a cold container from appearing hung.
MAX_INIT_SECONDS=120

# Load the embedding model in the background after boot so /health answers fast.
WARMUP_ON_START=true

# Log level.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Frontend only (build time - set in Vercel, or .env for local dev)
# ---------------------------------------------------------------------------
# Full URL of the chat endpoint on the deployed backend.
# VITE_CHAT_API_URL=https://your-service.onrender.com/api/chat

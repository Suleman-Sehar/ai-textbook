// api/rag/index.js
// Main API router for RAG functionality

import { searchHandler, indexHandler } from './search.js';

/**
 * Main API handler for RAG endpoints
 * @param {Object} req - Request object
 * @param {Object} res - Response object
 */
export default async function handler(req, res) {
  // Set CORS headers
  res.setHeader('Access-Control-Allow-Credentials', true);
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'GET,OPTIONS,PATCH,DELETE,POST,PUT');
  res.setHeader(
    'Access-Control-Allow-Headers',
    'X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version'
  );

  if (req.method === 'OPTIONS') {
    res.status(200).end();
    return;
  }

  const { pathname } = new URL(req.url, `http://${req.headers.host}`);
  const pathParts = pathname.split('/').filter(Boolean);

  // Extract the specific endpoint from the path
  const endpoint = pathParts[pathParts.length - 1];

  switch (endpoint) {
    case 'search':
      return await searchHandler(req, res);
    case 'index':
      return await indexHandler(req, res);
    default:
      res.status(404).json({ error: 'Endpoint not found' });
  }
}

export { searchHandler, indexHandler };